# Python and editor caches (tracked source files are preserved)
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.venv/
venv/
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Local credentials and environment overrides
.env
.env.*
!.env.example
!.env.template

# Training logs and experiment outputs
/lightning_logs/
/.logs/
/logs/
/outputs/
/wandb/
/checkpoints/
/store/
/inference/
/tmp/
/tmp_ae/
/tmp*/
*.log
*.out
*.err

# Generated baseline alignments, sequences and plots
/baselines_msa/
/mpnn_results_baselines/
/baselines_laproteina/plots/
# Keep the existing analysis configuration in bioemu_plots.
/bioemu_plots/**/*.png
/bioemu_plots/**/*.svg
/bioemu_plots/**/*.pdf

# Other generated BioEmu runs and selected ensembles
/bioemu_ensembles*/
/best_pdbs*/
/top_designs*/
/top_full_ensembles*/
/top_ensembles*/
/.bioemu_embeds_cache/

# Runtime trajectory files
*.xtc
*.trr
*.dcd

# Large downloaded model weights are local.
# Rules are scoped: source examples, configs and papers are not hidden by extension.
/ProteinMPNN/ca_model_weights/*.pt
/ProteinMPNN/vanilla_model_weights/*.pt
/ProteinMPNN/soluble_model_weights/*.pt
